{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MocikaShield",
  "version": "1.2.0-rc.3",
  "identifier": "dev.mocika.shield-gui",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mocika Shield",
        "width": 960,
        "height": 780,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/png/32x32.png",
      "icons/png/128x128.png",
      "icons/png/256x256.png",
      "icons/png/512x512.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../../../tools/apktool_3.0.1.jar": "tools/apktool.jar",
      "../../../tools/apksigner.jar": "tools/apksigner.jar",
      "../../../shield-stub/build/outputs/resources/resources.zip": "resources/resources.zip"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
